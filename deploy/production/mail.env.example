# The Mailgun credential, and nothing else.
#
#   cp deploy/production/mail.env.example deploy/production/mail.env
#   $EDITOR deploy/production/mail.env
#
# Read straight into the control plane's environment by compose, which is why
# these are COMPOSECTL_* names rather than NAVARCH_* ones — nothing substitutes
# them through .env on the way. A separate file so the key can be rotated
# without opening the one that holds the database password, and so the value
# never passes through `docker compose config` output.
#
# Absent is fine. Every path that would send simply does not: a failed rollout
# is still recorded as failed, a preview still expires on time. Only an operator
# invite fails outright, because an invite nobody receives is not an invite.

# The sending domain. A Mailgun subdomain SENDS and does not RECEIVE — do not
# use an address at it anywhere something has to reach you, NAVARCH_ACME_EMAIL
# above all: Let's Encrypt mails expiry warnings, and one nobody reads is worse
# than none.
COMPOSECTL_MAILGUN_DOMAIN=mg.example.com

# Mailgun → Sending → Domain settings → API keys. A *sending* key scoped to the
# domain above, not the account-wide private key: this one can send mail, where
# the account key can also read logs, list suppressions and change DNS settings.
COMPOSECTL_MAILGUN_API_KEY=change-me

# The envelope sender. It must be at the domain above or Mailgun refuses it.
COMPOSECTL_MAIL_FROM=Navarch <navarch@mg.example.com>

# Region. Leave empty for the US. An EU-hosted domain MUST set this — the US
# host answers an EU key with a 401, which reads exactly like a bad key and has
# cost people an afternoon.
#   COMPOSECTL_MAILGUN_BASE_URL=https://api.eu.mailgun.net
COMPOSECTL_MAILGUN_BASE_URL=
