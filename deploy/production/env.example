# Copy to .env beside deploy/production/compose.yaml and fill in.
# `docker compose config` prints the compose file verbatim, which is why none of
# these are literals in it.

# The release to run. Pin an exact version — :latest makes "restart" and
# "upgrade" the same operation, and only one of those is something you chose.
NAVARCH_VERSION=1.2.0

# Database. The password is only ever used inside the compose network.
POSTGRES_USER=navarch
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=navarch

# The shared service token. It opens node registration and /metrics, and
# nothing else — but enrolling a node is enough to matter, so generate it:
#   openssl rand -hex 32
NAVARCH_SERVICE_TOKEN=change-me-openssl-rand-hex-32

# The first operator. Its token is minted on first boot and logged exactly
# once; there is no second copy, so capture it then:
#   docker compose logs controlplane | grep bootstrap
NAVARCH_OPERATOR_EMAIL=you@example.com

# The wildcard domain preview environments are generated under. Point a
# wildcard DNS record at this host for it to resolve for anyone else.
NAVARCH_PREVIEW_DOMAIN=preview.example.com

# The domain the platform's own surfaces are served on. The console answers on
# console.<this name> and the API on api.<this name>, both over TLS.
#
# The bare domain is deliberately left alone. It is where you deploy a stack —
# a marketing site, usually — and the control plane generates that route like
# any other tenant's. A static route on the apex would fight it: two routers
# with the same Host rule is not an error in Traefik, it is an arbitrary winner.
#
# Left as a reserved name rather than a real one on purpose. This file is copied
# to .env and started, and compose's `:?` guard cannot fire on a value that is
# present — so a real domain here would be inherited by every install that
# forgot to edit it, pointing their ACME requests at a name they do not own and
# spending someone else's failed-validation budget.
NAVARCH_DOMAIN=example.com

# Where Let's Encrypt sends expiry warnings. Required: ACME will not issue
# without it, and the first you would know is every route serving a self-signed
# certificate.
NAVARCH_ACME_EMAIL=you@example.com

# DNS provider for the preview wildcard. Leave it EMPTY unless you need it.
#
# Empty is the ordinary install: every hostname — console, API, each tenant,
# each preview — gets its own certificate over the HTTP-01 challenge, and no
# credential exists anywhere to be stolen.
#
# Set it and previews instead share one `*.<NAVARCH_PREVIEW_DOMAIN>`
# certificate, proved over DNS-01. Setting this one variable turns on the whole
# path: the control plane starts pointing preview routes at the `lewild`
# resolver, and Traefik starts being able to satisfy it.
#
# The reason to bother is issuance volume, not TLS. A preview hostname is minted
# per CI run and never reused, so with a certificate each, previews approach the
# CA's per-registered-domain weekly limit long before tenants do — and hitting
# it stops issuance for the whole domain, tenants included.
#
# The cost is a credential in the ingress. It goes in dns.env beside this file,
# never here; see dns.env.example, and scope the token to the preview zone.
#
#   cloudflare | route53 | digitalocean | gandiv5 | infomaniak | ...
#   https://doc.traefik.io/traefik/https/acme/#providers
NAVARCH_DNS_PROVIDER=

# A site that was already on this host when Navarch arrived.
#
# Traefik must own 80 and 443 — the HTTP-01 challenge is answered on 80 and
# there is no second process that can hold it — so an incumbent moves BEHIND
# Traefik, not beside it. Set these and platform.yml grows a static route for
# it; leave them empty and it emits nothing at all.
#
# NAVARCH_COEXIST_TARGET is where the incumbent now listens, reached from
# inside the Traefik container: the docker0 bridge address and its new port.
# Plain HTTP — TLS terminates at Traefik, and terminating again behind it is
# two places to renew a certificate and two answers to "is this site https".
#
# NAVARCH_COEXIST_CERT/KEY serve its EXISTING certificate from the first
# request, so the cutover has no window where Traefik answers with a
# self-signed default. On a site with HSTS that window is not an ugly warning,
# it is a hard refusal in every browser with no click-through.
#
#   NAVARCH_COEXIST_DOMAIN=example.org
#   NAVARCH_COEXIST_TARGET=172.17.0.1:8080
#   NAVARCH_COEXIST_CERT_DIR=/etc/letsencrypt
#   NAVARCH_COEXIST_CERT=/coexist-certs/live/example.org/fullchain.pem
#   NAVARCH_COEXIST_KEY=/coexist-certs/live/example.org/privkey.pem
NAVARCH_COEXIST_DOMAIN=

# Redirect www.<domain> to the bare domain, permanently.
#
# Off by default, and the default is the careful one: this router asks ACME for
# a certificate for www.<domain> as soon as it exists, so on an install with no
# www record it is a validation that fails on every retry forever.
#
# Turn it on when www DOES resolve here. A name that reaches this host with no
# router gets Traefik's self-signed default, and a certificate warning is a
# worse answer than NXDOMAIN — a visitor who typed www can read a redirect, but
# not a browser interstitial.
NAVARCH_WWW_REDIRECT=

# How Traefik reaches containers this node publishes. 172.17.0.1 is the usual
# docker0 bridge address; check yours with:
#   ip -4 addr show docker0
NAVARCH_ADVERTISE_ADDR=172.17.0.1

# How much memory this node advertises for placement.
#
# A budget you declare, not a measurement. Reservations come from services'
# declared limits, and a blue/green rollout holds the old and new revisions at
# once — so a stack whose swappable services total 1 GB reserves 2 GB while it
# rolls. Nothing releases a live environment's reservation, so this fills up and
# stays full; "no ready node has enough free" is the budget working.
#
# Set it to the host's RAM MINUS about 1 GB, which is what the platform itself
# needs: Postgres, the control plane, the agent, Traefik, the console and the
# Docker daemon. Measured idle they are about 150 MB together; 1 GB is the
# headroom for Postgres under load and image pulls.
#
#   4 GB host -> 3072      8 GB host -> 7168      16 GB host -> 15360
#
# Leaving this at the host's full RAM makes the platform's own footprint
# invisible to the scheduler, which will then fill the box until the kernel
# starts killing things.
NAVARCH_NODE_MEMORY_MB=3072
