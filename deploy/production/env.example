# Copy to .env beside deploy/production/compose.yaml and fill in.
# `docker compose config` prints the compose file verbatim, which is why none of
# these are literals in it.

# The release to run. Pin an exact version — :latest makes "restart" and
# "upgrade" the same operation, and only one of those is something you chose.
NAVARCH_VERSION=1.0.0

# Database. The password is only ever used inside the compose network.
POSTGRES_USER=navarch
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=navarch

# The shared service token. It opens node registration and /metrics, and
# nothing else — but enrolling a node is enough to matter, so generate it:
#   openssl rand -hex 32
NAVARCH_SERVICE_TOKEN=change-me-openssl-rand-hex-32

# The first operator. Its token is minted on first boot and logged exactly
# once; there is no second copy, so capture it then:
#   docker compose logs controlplane | grep bootstrap
NAVARCH_OPERATOR_EMAIL=you@example.com

# The wildcard domain preview environments are generated under. Point a
# wildcard DNS record at this host for it to resolve for anyone else.
NAVARCH_PREVIEW_DOMAIN=preview.example.com

# How Traefik reaches containers this node publishes. 172.17.0.1 is the usual
# docker0 bridge address; check yours with:
#   ip -4 addr show docker0
NAVARCH_ADVERTISE_ADDR=172.17.0.1

# How much memory this node advertises for placement. Reservations come from
# declared limits, not measured usage, so this is a budget rather than a
# measurement — set it below the host's real RAM.
NAVARCH_NODE_MEMORY_MB=4096
