# The DNS-provider credential, and nothing else.
#
# Copy to dns.env beside this file. It is read only by Traefik, and only to
# answer the DNS-01 challenge for one wildcard: `*.<NAVARCH_PREVIEW_DOMAIN>`.
# Nothing else in the stack sees it, which is the point of it being a separate
# file — .env holds the database password and the service token, and the one
# container facing the internet has no business with either.
#
# You need this only if NAVARCH_DNS_PROVIDER is set. Leave both alone and every
# hostname keeps its own HTTP-01 certificate, with no credential anywhere.
#
# Which variables go here is your provider's business, not Navarch's: Traefik
# hands the challenge to lego, and each provider reads its own names. The list
# is at https://doc.traefik.io/traefik/https/acme/#providers.

# --- Route 53 (NAVARCH_DNS_PROVIDER=route53) ------------------------------
# An IAM user with an access key, and a policy scoped to ONE hosted zone. The
# default AmazonRoute53FullAccess would let a stolen ingress credential rewrite
# every zone in the account, which is a bad trade for a certificate.
#
#   {
#     "Version": "2012-10-17",
#     "Statement": [
#       {"Effect":"Allow","Action":["route53:GetChange"],
#        "Resource":"arn:aws:route53:::change/*"},
#       {"Effect":"Allow","Action":["route53:ListResourceRecordSets",
#                                   "route53:ChangeResourceRecordSets"],
#        "Resource":"arn:aws:route53:::hostedzone/YOUR_ZONE_ID"},
#       {"Effect":"Allow","Action":["route53:ListHostedZonesByName"],
#        "Resource":"*"}
#     ]
#   }
#
# Narrower still, and worth it: delegate preview.<your domain> to its own hosted
# zone with an NS record, then scope the policy to THAT zone id. The credential
# in the ingress then cannot touch the apex, the API record or the console
# record — the three names whose loss is an outage rather than an inconvenience.
# Traefik does not care which zone the challenge record lands in.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1

# --- Cloudflare (NAVARCH_DNS_PROVIDER=cloudflare) -------------------------
# A scoped API token, NOT the global API key. The global key can do anything to
# every domain on the account; this one needs exactly Zone:DNS:Edit, and only on
# the zone the preview domain lives in.
# CF_DNS_API_TOKEN=change-me

# Scope it further if you can be bothered, and you should: delegate
# preview.<your domain> to its own zone with an NS record, then issue the token
# against that zone alone. The credential in the ingress then cannot touch the
# apex, the API record, or the console record — the three names whose loss would
# be an outage rather than an inconvenience. Traefik does not care; the
# challenge record is written under the delegated zone either way.

# --- Other providers, for reference ---------------------------------------
# DigitalOcean (digitalocean) DO_AUTH_TOKEN
# Gandi      (gandiv5)      GANDIV5_API_KEY
# Infomaniak (infomaniak)   INFOMANIAK_ACCESS_TOKEN
